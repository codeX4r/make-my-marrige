# Copy to .env for local development. These values are development-only.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27018/makemymarrige?replicaSet=rs0&directConnection=true
LOG_LEVEL=info
REDIS_URL=redis://127.0.0.1:6379
WORKER_HEALTH_PORT=4001
# For `pnpm dev` on the host. In a container network, use the API service DNS name.
API_BASE_URL=http://127.0.0.1:4000
# Optional BFF upstream timeout in milliseconds (100-30000; default 5000).
BFF_UPSTREAM_TIMEOUT_MS=5000
