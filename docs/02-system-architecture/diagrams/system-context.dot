 ops [label="Platform operations\nSupport / monitoring", fillcolor="#FFF4E5"];
 co -> browser; org -> browser; guest -> browser;
 browser -> system [label="HTTPS / session"];
 system -> places [dir=both, label="provider adapter"];
 system -> otp [dir=both, label="provider adapter"];
 system -> upi [dir=both, label="payment intent / webhook"];
