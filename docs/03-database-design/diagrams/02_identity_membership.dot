
digraph G {
 graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.65", label="Identity, Workspace and Membership ERD", labelloc=t, fontsize=18, fontname="Arial"];
 node [shape=record, style="rounded,filled", fillcolor="#EEF4FA", color="#315A7D", fontname="Arial", fontsize=9];
 edge [color="#607D8B", fontname="Arial", fontsize=8, arrowsize=0.7];
 users [label="{users (global)|_id PK\\lemailNormalized UQ\\laccountStatus\\l}"];
 sessions [label="{sessions (global)|_id PK\\luserId FK\\lrefreshTokenHash\\lexpiresAt\\l}"];
 weddings [label="{weddings|_id PK\\lweddingDate YYYY-MM-DD\\ltimezone\\llifecycleStatus\\l}"];
 memberships [label="{weddingMemberships|_id PK\\lweddingId FK\\luserId FK\\lmemberType / status\\l}"];
 invites [label="{invitations|_id PK\\lweddingId FK\\linvitedEmailNormalized\\ltokenHash UQ\\lstatus / expiresAt\\l}"];
 periods [label="{membershipPeriodEvents|_id PK\\lweddingId FK\\lmembershipId FK\\levent / occurredAt\\l}"];
 users -> sessions [label="1:N"];
 users -> memberships [label="1:N history"];
 weddings -> memberships [label="1:N"];
 weddings -> invites [label="1:N"];
 memberships -> periods [label="1:N"];
}
