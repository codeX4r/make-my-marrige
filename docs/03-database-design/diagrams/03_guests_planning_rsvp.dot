
digraph G {
 graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.3", ranksep="0.6", label="Guests, Functions, Tasks and RSVP ERD", labelloc=t, fontsize=18, fontname="Arial"];
 node [shape=record, style="rounded,filled", fillcolor="#EEF4FA", color="#315A7D", fontname="Arial", fontsize=8.5];
 edge [color="#607D8B", fontname="Arial", fontsize=8, arrowsize=0.7];
 weddings [label="{weddings|_id PK}"];
 households [label="{households|_id PK\\lweddingId FK\\lprimaryContactGuestId\\lstatus\\l}"];
 guests [label="{guests|_id PK\\lweddingId FK\\lhouseholdId FK\\lfullName / status\\l}"];
 corrections [label="{guestCorrectionRequests|_id PK\\lweddingId FK\\lrequester / reviewer\\lstatus / version\\l}"];
 functions [label="{weddingFunctions|_id PK\\lweddingId FK\\ldate / venueVisibility\\lpublicationStatus\\l}"];
 pub [label="{functionPublicationSnapshots|_id PK\\lfunctionId FK\\lsnapshotVersion\\l}"];
 inv [label="{functionGuestInvitations|_id PK\\lfunctionId FK\\lguestId FK\\lstatus\\l}"];
 rsvp [label="{rsvps|_id PK\\lweddingId FK\\lfunctionId FK\\lguestId FK\\lresponse / version\\l}"];
 events [label="{rsvpEvents|_id PK\\lrsvpId FK\\lprevious/new response\\l}"];
 tasks [label="{tasks|_id PK\\lweddingId FK\\lfunctionId? FK\\lstatus / dueAt\\l}"];
 assign [label="{taskAssignments|_id PK\\ltaskId FK\\lassignee\\lisResponsible\\lstatus\\l}"];
 checklist [label="{taskChecklistItems|_id PK\\ltaskId FK\\lisMandatory / status\\l}"];
 deps [label="{taskDependencies|_id PK\\ltaskId FK\\ldependsOnTaskId FK\\l}"];
 weddings -> households; weddings -> functions; weddings -> tasks;
 households -> guests [label="1:N"];
 guests -> corrections [label="1:N requests"];
 functions -> pub [label="1:N versions"];
 functions -> inv; guests -> inv;
 functions -> rsvp; guests -> rsvp [label="1:N"];
 rsvp -> events [label="1:N"];
 functions -> tasks [label="0:N"];
 tasks -> assign; tasks -> checklist; tasks -> deps;
}
