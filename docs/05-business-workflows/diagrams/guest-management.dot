digraph G {
 graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.6", labelloc=t, label="Guest and Household Management — WF04 / WF05", fontsize=22, fontname="Arial"];
 node [shape=box, style="rounded,filled", fontname="Arial", fontsize=9.5, margin="0.14,0.1", color="#315A7D", fillcolor="#EEF4FA"];
 edge [fontname="Arial", fontsize=8.5, color="#607D8B", arrowsize=0.7];
 create [label="Co-owner / authorised organiser\ncreates household + individual guests"];
 contact [label="Assign primary contact\nMust be active guest in same household"];
 tags [label="Relationship tags\nOne active primary + multiple secondary\nTemporary untagged state allowed"];
 invite [label="Function invitation\nGuest eligibility is individual\nNew household members not auto-invited"];
 otp [label="Invitation-bound guest email OTP (Brevo)\nVerifies email-channel control,\nnot legal identity"];
 rsvp [label="Self RSVP\nIndividual response per function\nEditable until deadline"];
 request [label="Correction / merge / transfer\nReview workflow + audit\nMerge requires both co-owners"];
 create -> contact -> tags -> invite -> otp -> rsvp;
 tags -> request; invite -> request [style=dashed];
}
